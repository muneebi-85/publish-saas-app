datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                String    @id @default(cuid())
  clerkId           String    @unique
  email             String?
  name              String?
  avatarUrl         String?
  role              Role      @default(MEMBER)
  plan              String    @default("free")
  auditsUsed        Int       @default(0)
  periodStart       DateTime?
  periodEnd         DateTime?
  lsCustomerId      String?
  deleteScheduledAt DateTime?
  /// Opt-out for non-essential mail (review-ready notices, quota warnings).
  /// Transactional billing and security mail is always sent and is deliberately
  /// not switchable — we cannot legally or safely suppress a payment failure.
  productEmails     Boolean   @default(true)
  /// Last time the user opened their activity feed. The feed itself is derived
  /// from real rows (jobs, reports, subscriptions), so this single timestamp is
  /// all the read-state that needs storing — anything newer than it is unread.
  activitySeenAt    DateTime?
  /// Brand-kit preferences (colors, fonts, tone, banned words) as saved from
  /// Settings/Brand Kit. Null until the user saves at least once.
  brandKit          Json?
  /// Unique referral code for the "share and earn" program. Generated
  /// automatically the first time the user visits the referral section.
  referralCode      String?   @unique
  /// Free audits earned through the referral or challenge program. Spent once
  /// the plan's monthly allowance is full, so bonus credits extend the wall.
  referralCredits   Int       @default(0)
  /// Opt-in for the public leaderboard ("best scores this week"). Off by
  /// default — nothing about a creator's scores is public unless they flip
  /// this on. Only opted-in users' reports can appear on /community.
  leaderboardOptIn  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscriptions    Subscription[]
  reports          AnalysisReport[]
  projects         Project[]
  comments         Comment[]
  channels         Channel[]
  jobs             AnalysisJob[]
  referralsGiven   Referral[]        @relation("referrer")
  referralsUsed    Referral[]        @relation("referee")
  challengesGiven  Challenge[]       @relation("challenger")
  challengesBeat   Challenge[]       @relation("acceptedBy")
  coachThreads     CoachThread[]

  @@index([clerkId])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lsSubscriptionId   String    @unique
  plan               String
  status             String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

model AnalysisReport {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Human-facing correlation id for one review run (`pub_<base36>`), generated
  /// at enqueue time and echoed inside the report payload so a support request
  /// can be traced to a run. Deliberately NOT a foreign key to `Project`: the
  /// review pipeline never creates a Project row, so an FK here would reject
  /// every insert. Reports are the app's own top-level unit and cascade from User.
  projectId         String
  title             String
  targetPlatform    String
  monetizationScore Int
  overallScore      Int
  report            Json
  /// When the creator published the public score card. Null until they click
  /// "Share score" — the opt-in every public surface (share page, share API,
  /// badge, OG image, community board, challenge accepts) gates on. Without
  /// it, every report was world-readable at /share/<id> by default, which
  /// contradicted the copy that called sharing "opt-in".
  sharedAt          DateTime?
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, projectId])
}

/// One audit run. Created at enqueue time so the client has a real row to poll
/// and so the quota debit can happen before any work is dispatched (a job the
/// user never paid for can never be queued). `reportId` is filled in only once
/// the worker has actually persisted a report — until then the UI shows
/// progress, never a link to something that does not exist.
///
/// `input` holds the validated review payload. The queue message carries only
/// this row's id, so a replayed or forged message can never retarget another
/// user or smuggle in unvalidated input — the worker always re-reads from here.
model AnalysisJob {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String
  title          String
  targetPlatform String
  input          Json
  status         JobStatus @default(QUEUED)
  reportId       String?
  error          String?
  quotaCharged   Boolean   @default(false)
  /// True when the debit that paid for this run consumed a referral/challenge
  /// credit instead of the plan's monthly allowance. The terminal-failure
  /// refund must restore the pool it was paid from — restoring the allowance
  /// instead would mint free monthly capacity, and vice versa would destroy a
  /// credit the user earned.
  paidWithCredits Boolean  @default(false)
  attempts       Int       @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Project {
  id          String      @id @default(cuid())
  title       String
  description String?
  folder      String      @default("General")
  tags        String[]
  status      String      @default("Completed")
  riskLevel   RiskLevel   @default(LOW)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      MediaAsset?
  comments    Comment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, createdAt])
}

model MediaAsset {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoName       String?
  videoSize       String?
  videoDuration   String?
  thumbnailUrl    String?
  scriptText      String?
  voiceName       String?
  metaTitle       String?
  metaDescription String?
  metaTags        String[]
  createdAt       DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Channel {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String
  channelId   String
  name        String
  url         String?
  avatarUrl   String?
  /// BigInt, not Int: lifetime view counts of large channels (100B+) overflow
  /// a 32-bit INT4. Reads convert to Number at the boundary — exact for every
  /// realistic count (well within 2^53).
  subscribers BigInt   @default(0)
  videosCount BigInt   @default(0)
  viewsCount  BigInt   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Scoped to the owner, not global. A global unique on (platform, channelId)
  /// meant the second user to connect the same channel hit a P2002 conflict
  /// instead of the intended 409 — and made the ownership check unenforceable,
  /// since the row could only ever belong to whoever connected first. The
  /// scoped index lets the route decide: a channel already claimed by another
  /// account is refused there (409), and if sharing an agency channel is ever
  /// product-sanctioned, the rule change lives in the route, not the index.
  @@unique([userId, platform, channelId])
  @@index([userId])
  /// Backs the cross-owner "is this channel already connected?" lookup in
  /// POST /api/channels, which is not covered by the owner-scoped unique above.
  @@index([platform, channelId])
}

model WebhookEvent {
  id        String   @id // Stores the dedupKey
  createdAt DateTime @default(now())
}

/// A referral signup: the referrer got credit, the referee got a free audit.
model Referral {
  id         String   @id @default(cuid())
  code       String
  /// The user whose link was shared (internal DB id).
  referrerId String
  referrer   User     @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  /// The account created from that link (internal DB id).
  refereeId  String   @unique
  referee    User     @relation("referee", fields: [refereeId], references: [id], onDelete: Cascade)
  /// Both sides earn one free audit per referral. The REFEREE's credit is
  /// granted at attach (`granted` guards a retried attach from double-paying).
  /// The REFERRER's credit is paid only once the referee completes their
  /// first review (`referrerCreditedAt`, stamped by the review worker):
  /// paying it at attach let a farmer mint unlimited audits from throwaway
  /// signups — now every farmed credit costs a real pipeline run.
  granted            Boolean   @default(false)
  referrerCreditedAt DateTime?
  createdAt          DateTime  @default(now())

  @@index([referrerId])
  @@index([code])
}

/// A "challenge a friend" share. The token is the anchored report id (a cuid,
/// unguessable), so issuing a challenge is just sharing a link — but the row
/// records who accepted, against which report, so both sides can be credited
/// exactly once and the challenger can be notified.
model Challenge {
  id                String    @id @default(cuid())
  /// The report whose score is the one to beat (any user's shared report).
  reportId          String
  /// The creator who issued the challenge (owner of `reportId`).
  challengerId      String
  challenger        User      @relation("challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  /// The person who accepted and produced their own report, once set.
  acceptedByUserId  String?
  acceptedBy        User?     @relation("acceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  /// Their report id, once they finish a challenge-context review.
  acceptedReportId  String?
  acceptedAt        DateTime?
  createdAt         DateTime  @default(now())

  /// One accepter can only ever close a given challenge once. The unique
  /// (reportId, acceptedByUserId) pair is the real concurrency guard: the
  /// route's findFirst pre-check is advisory only, and without this constraint
  /// two concurrent accepts both pass it and both pay the challenger a credit.
  @@unique([reportId, acceptedByUserId])
  @@index([challengerId])
  @@index([reportId])
}

/// A persisted AI Coach conversation. The client sends and receives plain
/// messages exactly as before; this row is where they live between visits.
/// `reportId` is optional — when set, the coach builds its context from that
/// report's scores and top fixes so the advice is grounded in the creator's
/// actual review instead of being generic.
model CoachThread {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("New conversation")
  reportId   String?
  messages   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// A landing-page newsletter signup.
///
/// The form used to call `setSubscribed(true)` and nothing else: it told the
/// visitor to "check your inbox" while the address was discarded on the spot.
/// This row is where an address goes now, so the promise the form makes is one
/// the app can keep.
///
/// No `User` relation — most signups happen before anyone has an account, and
/// tying the row to a user would mean either dropping anonymous addresses or
/// creating shell accounts for them.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  /// Lower-cased and trimmed before write, so `A@b.com` and `a@b.com ` are one
  /// subscriber rather than two.
  email     String   @unique
  /// Which surface it came from, for when there is more than one form.
  source    String   @default("landing-footer")
  /// Set when the address is unsubscribed. Kept rather than deleted so a
  /// re-signup cannot quietly resurrect someone who opted out.
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
