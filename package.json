    "@radix-ui/react-tooltip": "^1.2.16",
    "@upstash/qstash": "^2.11.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.300.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "posthog-js": "^1.417.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.1",
    "sonner": "^2.0.7",
    "svix": "^1.99.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
