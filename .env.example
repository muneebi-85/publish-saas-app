# ───────────────────────────────────────────────────
#  Publish — environment variables template
#  Copy this file to `.env.local` and fill in real values.
#  NEVER commit .env.local (it is gitignored).
# ───────────────────────────────────────────────────

# ── App ────────────────────────────────────────────
# In production, use https://publish.genapps.online (subdomain of your verified
# Lemon Squeezy domain). Locally, keep http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Publish

# ── Legal / business identity ──────────────────────
# Shown on every legal page and email footer. Fill these BEFORE going live —
# GDPR and most consumer-protection laws require a real business name + address.
NEXT_PUBLIC_LEGAL_ENTITY="Publish Labs Ltd."
NEXT_PUBLIC_LEGAL_ADDRESS="Your registered business address"
NEXT_PUBLIC_GOVERNING_LAW="the laws of England and Wales"
NEXT_PUBLIC_SUPPORT_EMAIL=support@genapps.online
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@genapps.online
NEXT_PUBLIC_BILLING_EMAIL=billing@genapps.online
NEXT_PUBLIC_DMCA_EMAIL=dmca@genapps.online

# ── AI Provider: NVIDIA NIM (primary) ──────────────
# Get keys: https://build.nvidia.com/
# The key you already have MUST BE ROTATED — treat the one you pasted as public.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model overrides (safe defaults are in src/lib/ai/models.ts)
# NVIDIA_MODEL_REASONING=nvidia/llama-3.3-nemotron-super-49b-v1
# NVIDIA_MODEL_FAST=meta/llama-3.3-70b-instruct
# NVIDIA_MODEL_VISION=meta/llama-3.2-90b-vision-instruct

# ── Optional AI fallback ───────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Database (Neon or Supabase Postgres) ───────────
DATABASE_URL="postgresql://user:password@host:5432/publish?sslmode=require"

# ── Authentication (Clerk recommended) ─────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Signing secret for the Clerk webhook (Dashboard → Webhooks → your endpoint).
# Without it, /api/webhooks/clerk refuses to process events (svix cannot verify).
# CLERK_WEBHOOK_SECRET=whsec_...

# ── Payments: Lemon Squeezy ────────────────────────
# Docs: https://docs.lemonsqueezy.com/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs from your Lemon Squeezy store:
LEMONSQUEEZY_VARIANT_STARTER=1946546
LEMONSQUEEZY_VARIANT_PRO=1946557
LEMONSQUEEZY_VARIANT_AGENCY=1946562
# Annual-billing variants (same plans, yearly interval — 2 months free):
LEMONSQUEEZY_VARIANT_STARTER_YEARLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_AGENCY_YEARLY=

# ── File uploads (S3 or Cloudflare R2 — the S3 API is the same) ─────────────
# These are the variables src/lib/env.ts actually reads; the upload presign
# route returns a helpful 503 until the first three are set. Uploads use
# presigned POST policies (src/lib/upload/post-policy.ts) — the provider
# enforces the content-type and size limits on the wire, so S3/R2 must accept
# browser form POSTs (both do; MinIO too).
S3_BUCKET=
S3_REGION=auto                       # 'auto' for R2; e.g. us-east-1 for AWS S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for R2 / MinIO, leave empty for real AWS S3:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Public read origin for uploaded assets (R2 custom domain / CDN). Also the
# only origin a brand-kit logo URL may point at:
# S3_PUBLIC_URL=https://cdn.example.com

# ── Background jobs (Upstash QStash) ─────────────────────
# Reviews are enqueued through QStash when this is set. Without it the analyze
# route runs each review inline — slower for the caller, but fully functional.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# ── Audio transcription (Deepgram) ─────────────────
# Absent → voice analysis estimates cadence from the transcript text alone.
# DEEPGRAM_API_KEY=

# ── Email (transactional) ──────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Publish <hello@publish.genapps.online>"

# ── Rate limiting (Upstash Redis) ──────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Cron protection ────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`; generate with
# `openssl rand -hex 32`.
# CRON_SECRET=

# ── Analytics / monitoring (PostHog) ───────────────
# Product funnels (analyze_started → report_completed, quota_wall_seen,
# upgrade_clicked, share_link_copied, challenge_clicked...). Events only fire
# after the visitor accepts analytics cookies; with no key set, analytics is a
# no-op and nothing is loaded. Get a key: https://us.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Channel OAuth (YouTube / TikTok) ────────────────
# Channel connections go through Clerk's managed OAuth (Google for YouTube,
# TikTok for TikTok) — see src/components/channels/useConnectChannel.ts. To
# enable them, turn on the Google (and TikTok) providers in the Clerk dashboard
# (User & Authentication → Social Connections) and add the redirect URL
#   {APP_URL}/sso-callback
# to the provider's OAuth consent screen. No code change is needed once the
# providers are enabled. The keys below are legacy data-fetch fallbacks and can
# stay empty when Clerk OAuth is used:
# YOUTUBE_API_KEY=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# ── Analytics / monitoring (legacy) ─────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ── ML scoring model (optional) ──────────────────────
# Absolute path to the exported GBDT artefact produced by
# `python -m publishml.export` (see ml/README.md). When unset, the app looks
# for src/lib/ml/publish-model.json and disables publish-score if absent.
# PUBLISH_MODEL_PATH=
